<Window x:Class="Lab7.NET.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Міські сповіщення" Height="500" Width="640"
        Background="#DCEBFA">

    <Window.Resources>
        <!-- Стиль для кнопок -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2E7BCF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderBrush" Value="#1F5A9E"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- Стиль для написів -->
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1B3A5C"/>
        </Style>
        <!-- Стиль для полів введення -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#2E7BCF"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Панель керування" Grid.Row="0" Margin="0,0,0,10"
                  Background="#BBD7F2" BorderBrush="#2E7BCF" BorderThickness="2"
                  FontWeight="Bold" Foreground="#1B3A5C">
            <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Вітер (м/с):" Width="130" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtWind" Width="80" Text="10"/>
                    <Button x:Name="btnWind" Content="Встановити" Width="120" Margin="10,0,0,0" Click="btnWind_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Температура (°C):" Width="130" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtTemp" Width="80" Text="5"/>
                    <Button Content="Встановити" Width="120" Margin="10,0,0,0" Click="btnTemp_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Опади (мм):" Width="130" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtRain" Width="80" Text="0"/>
                    <Button Content="Встановити" Width="120" Margin="10,0,0,0" Click="btnRain_Click"/>
                </StackPanel>
                <Button Content="Виконати план дій міста" Width="260"
                        HorizontalAlignment="Left" Margin="0,10,0,0"
                        Background="#C0392B" BorderBrush="#8E2A20" Click="btnPlan_Click"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Журнал подій" Grid.Row="1"
                  Background="#BBD7F2" BorderBrush="#2E7BCF" BorderThickness="2"
                  FontWeight="Bold" Foreground="#1B3A5C">
            <ListBox x:Name="logListBox" Background="White" BorderBrush="#2E7BCF"
                     FontWeight="Normal" FontSize="13" Margin="4"/>
        </GroupBox>
    </Grid>
</Window>